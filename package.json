{
  "name": "toys-for-kiro",
  "displayName": "Kiro Usage",
  "description": "Credits, quota & context usage stats. Local token, latency & cost dashboard for Kiro IDE (unofficial, offline). Kiro 用量、额度与上下文统计面板。",
  "version": "0.5.0",
  "publisher": "moluogh",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#24104e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MOLUOGH/toys-for-kiro.git"
  },
  "bugs": {
    "url": "https://github.com/MOLUOGH/toys-for-kiro/issues"
  },
  "homepage": "https://github.com/MOLUOGH/toys-for-kiro#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Machine Learning"
  ],
  "keywords": [
    "kiro",
    "kiro-ide",
    "usage",
    "credits",
    "quota",
    "tokens",
    "context",
    "dashboard",
    "stats",
    "monitor",
    "analytics",
    "billing",
    "cost",
    "用量",
    "额度",
    "统计",
    "监控",
    "上下文"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "toysForKiro.openDashboard",
        "title": "%command.openDashboard%",
        "category": "Kiro Usage",
        "icon": "$(pie-chart)"
      },
      {
        "command": "toysForKiro.exportData",
        "title": "%command.exportData%",
        "category": "Kiro Usage",
        "icon": "$(export)"
      },
      {
        "command": "toysForKiro.openSettings",
        "title": "%command.openSettings%",
        "category": "Kiro Usage",
        "icon": "$(gear)"
      },
      {
        "command": "toysForKiro.refresh",
        "title": "%command.refresh%",
        "category": "Kiro Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "toysForKiro.rebuildIndex",
        "title": "%command.rebuildIndex%",
        "category": "Kiro Usage"
      },
      {
        "command": "toysForKiro.clearData",
        "title": "%command.clearData%",
        "category": "Kiro Usage"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "toysForKiro.refresh",
          "when": "activeWebviewPanelId == 'toysForKiro.dashboard'",
          "group": "navigation@1"
        },
        {
          "command": "toysForKiro.exportData",
          "when": "activeWebviewPanelId == 'toysForKiro.dashboard'",
          "group": "navigation@2"
        },
        {
          "command": "toysForKiro.openSettings",
          "when": "activeWebviewPanelId == 'toysForKiro.dashboard'",
          "group": "navigation@3"
        },
        {
          "command": "toysForKiro.rebuildIndex",
          "when": "activeWebviewPanelId == 'toysForKiro.dashboard'",
          "group": "1_maintenance@1"
        },
        {
          "command": "toysForKiro.clearData",
          "when": "activeWebviewPanelId == 'toysForKiro.dashboard'",
          "group": "1_maintenance@2"
        }
      ]
    },
    "configuration": {
      "title": "Kiro Usage",
      "properties": {
        "toysForKiro.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-CN",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh%",
            "%config.language.en%"
          ],
          "markdownDescription": "%config.language%"
        },
        "toysForKiro.contextWindowTokens": {
          "type": "number",
          "default": 1000000,
          "minimum": 1000,
          "markdownDescription": "%config.contextWindowTokens%"
        },
        "toysForKiro.modelContextWindows": {
          "type": "object",
          "default": {},
          "additionalProperties": {
            "type": "number"
          },
          "markdownDescription": "%config.modelContextWindows%"
        },
        "toysForKiro.creditPriceUsd": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.creditPriceUsd%"
        },
        "toysForKiro.importLegacySessions": {
          "type": "boolean",
          "default": true,
          "description": "%config.importLegacySessions%"
        },
        "toysForKiro.storage.mode": {
          "type": "string",
          "default": "disk",
          "enum": [
            "disk",
            "memory"
          ],
          "enumDescriptions": [
            "%config.storage.mode.disk%",
            "%config.storage.mode.memory%"
          ],
          "markdownDescription": "%config.storage.mode%"
        },
        "toysForKiro.storage.retentionDays": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "%config.storage.retentionDays%"
        },
        "toysForKiro.statusBar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar.enabled%"
        },
        "toysForKiro.statusBar.mode": {
          "type": "string",
          "default": "session",
          "enum": [
            "session",
            "today",
            "cycle"
          ],
          "enumDescriptions": [
            "%config.statusBar.mode.session%",
            "%config.statusBar.mode.today%",
            "%config.statusBar.mode.cycle%"
          ],
          "description": "%config.statusBar.mode%"
        },
        "toysForKiro.refreshIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 2,
          "maximum": 300,
          "description": "%config.refreshIntervalSeconds%"
        },
        "toysForKiro.defaultRange": {
          "type": "string",
          "default": "cycle",
          "enum": [
            "cycle",
            "today",
            "24h",
            "7d",
            "30d",
            "all"
          ],
          "enumDescriptions": [
            "%range.cycle%",
            "%range.today%",
            "%range.24h%",
            "%range.7d%",
            "%range.30d%",
            "%range.all%"
          ],
          "description": "%config.defaultRange%"
        }
      }
    }
  },
  "scripts": {
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/node.ps1 --test test/*.test.js",
    "package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package.ps1"
  }
}
